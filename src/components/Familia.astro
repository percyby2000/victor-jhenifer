---
const familyGroups = [
	{
		title: 'Padres de Victor',
		names: ['Víctor Berrocal', 'Emilia Ávalos'],
	},
	{
		title: 'Padres de Jhenifer',
		names: ['Máximo Huamán', 'Juliana Mendoza'],
	},
	{
		title: 'Padrinos',
		names: ['Isai tucno ', 'Mariel Oriundo'],
	},
];
---

<section class="family-section" aria-labelledby="family-title">
	<div class="family-content">
		<div class="family-icon" aria-hidden="true">
			<img src="/iconos/svgexport-8.svg" alt="" />
		</div>
		<p class="family-kicker">Con la bendici&oacute;n de nuestras familias</p>
		<h2 id="family-title">Padres y padrinos</h2>
		<div class="family-grid">
			{familyGroups.map((group) => (
				<article class="family-group">
					<h3>{group.title}</h3>
					<ul>
						{group.names.map((name) => <li>{name}</li>)}
					</ul>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.family-section {
		box-sizing: border-box;
		padding: clamp(4.5rem, 9vw, 6.5rem) 1.25rem;
		background: #FFFFFF;
		color: #04294A;
		text-align: center;
	}

	.family-content {
		width: min(100%, 64rem);
		margin: 0 auto;
	}

	.family-icon {
		display: grid;
		width: 4.8rem;
		height: 4.8rem;
		margin: 0 auto 1rem;
		place-items: center;
		border-radius: 50%;
		background: #DCEBF4;
	}

	.family-icon img {
		width: 2.65rem;
		height: 2.65rem;
		object-fit: contain;
	}

	.family-kicker {
		margin: 0 0 .7rem;
		color: #376282;
		font-family: var(--font-subtitulos);
		font-size: .65rem;
		font-weight: var(--grosor-fuente-regular);
		letter-spacing: .2em;
		line-height: 1.5;
		text-transform: uppercase;
		text-indent: .24em;
	}

	.family-content h2 {
		margin: 0 0 clamp(2.75rem, 6vw, 4rem);
		color: #04294A;
		font-family: var(--font-titulos);
		font-size: clamp(2.15rem, 5vw, 3.8rem);
		font-weight: var(--grosor-titulos);
		letter-spacing: .01em;
		line-height: 1.05;
	}

	.family-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 2.75rem clamp(2rem, 8vw, 7rem);
		align-items: start;
	}

	.family-group {
		min-height: 0;
		padding: 0;
	}

	.family-group:last-child {
		grid-column: 1 / -1;
		width: min(100%, 28rem);
		justify-self: center;
		padding-top: 2.5rem;
		background: transparent;
	}

	.family-group h3 {
		display: flex;
		align-items: center;
		justify-content: center;
		margin: 0 0 1.15rem;
		color: #376282;
		font-family: var(--font-subtitulos);
		font-size: .64rem;
		font-weight: var(--grosor-fuente-semi-bold);
		letter-spacing: .17em;
		line-height: 1.4;
		text-indent: .14em;
		text-transform: uppercase;
	}

	.family-group ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.family-group li {
		color: #04294A;
		font-family: var(--font-titulos);
		font-size: clamp(1.15rem, 1.8vw, 1.45rem);
		font-weight: var(--grosor-fuente-regular);
		line-height: 1.35;
		text-wrap: balance;
	}

	.family-group li + li {
		margin-top: .35rem;
	}

	@media (max-width: 650px) {
		.family-section {
			padding: 4.5rem 1rem;
		}

		.family-content h2 {
			margin-bottom: 2rem;
		}

		.family-grid {
			grid-template-columns: 1fr;
			gap: 2.25rem;
		}

		.family-group {
			min-height: auto;
			padding: 0 .5rem;
		}

		.family-group:last-child {
			grid-column: auto;
			width: auto;
			padding-top: 1rem;
		}
	}
</style>
