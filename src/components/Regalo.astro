<section class="gift-section" aria-labelledby="gift-title">
	<div class="gift-wash" aria-hidden="true"></div>
	<div class="gift-content">
		<h2 id="gift-title">Regalo</h2>
		<img class="gift-icon" src="/iconos/svgexport-10.svg" alt="" aria-hidden="true" />
		<p class="gift-message">
			Nuestro mejor regalo es que est&eacute;s con nosotros <br class="desktop-break" />
			 en nuestro d&iacute;a, pero si quer&eacute;is hacernos un <br class="desktop-break" />
			 obsequio, &iexcl;aqu&iacute; est&aacute; nuestro n&uacute;mero de cuenta!
		</p>
		<p class="account-holder">Victor Raul Berrocal Avalos</p>
		<button class="account-number" type="button" data-copy-account data-account="00344001335827058453" aria-label="Copiar n&uacute;mero de cuenta">
			<span class="account-number-value">0034 4001 3358 2705 8453</span>
		</button>

		<p class="copy-feedback" aria-live="polite"></p>
	</div>
</section>

<script>
	const accountButton = document.querySelector<HTMLButtonElement>('[data-copy-account]');
	const copyFeedback = document.querySelector<HTMLElement>('.copy-feedback');

	accountButton?.addEventListener('click', async () => {
		const account = accountButton.dataset.account ?? '';

		try {
			await navigator.clipboard.writeText(account);
			if (copyFeedback) copyFeedback.textContent = 'N\u00FAmero copiado';
		} catch {
			if (copyFeedback) copyFeedback.textContent = 'Selecciona el n\u00FAmero para copiarlo';
		}

		window.setTimeout(() => {
			if (copyFeedback) copyFeedback.textContent = '';
		}, 2200);
	});
</script>

