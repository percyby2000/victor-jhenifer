---
const photos = [
	{ src: '/fotos/1.webp', alt: 'Victor y Jhenifer compartiendo un momento especial' },
	{ src: '/fotos/2.webp', alt: 'Victor y Jhenifer celebrando su historia' },
	{ src: '/fotos/3.webp', alt: 'Un recuerdo especial de Victor y Jhenifer' },
	{ src: '/fotos/4.webp', alt: 'Victor y Jhenifer durante su historia de amor' },
	{ src: '/fotos/abrazo.webp', alt: 'Victor y Jhenifer abrazados' },
];
---

<section class="scroll-gallery" aria-labelledby="gallery-title">
	<div class="scroll-gallery-stage">
		<div class="gallery-heading">
			<p>Recuerdos para guardar</p>
			
		</div>

		<div class="gallery-track" aria-live="polite">
			{photos.map((photo, index) => (
				<figure class="gallery-slide" data-slide={index}>
					<img src={photo.src} alt={photo.alt} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
				</figure>
			))}
		</div>

		<div class="gallery-controls">
			<button class="gallery-arrow previous" type="button" aria-label="Foto anterior">&#8592;</button>
			<div class="gallery-progress" aria-hidden="true"><span></span></div>
			<button class="gallery-arrow next" type="button" aria-label="Siguiente foto">&#8594;</button>
		</div>
		
	</div>
</section>

<script>
	const gallery = document.querySelector<HTMLElement>('.scroll-gallery');
	const track = gallery?.querySelector<HTMLElement>('.gallery-track');
	const progress = gallery?.querySelector<HTMLElement>('.gallery-progress span');
	const slides = gallery?.querySelectorAll<HTMLElement>('.gallery-slide');
	const slideImages = gallery?.querySelectorAll<HTMLImageElement>('.gallery-slide img');
	const previousButton = gallery?.querySelector<HTMLButtonElement>('.previous');
	const nextButton = gallery?.querySelector<HTMLButtonElement>('.next');
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (gallery && track && slides?.length) {
		let frame = 0;
		let smoothingFrame = 0;
		let currentSlide = 0;
		let targetProgress = 0;
		let renderedProgress = 0;

		const clamp = (value: number) => Math.max(0, Math.min(1, value));
		const resizeSlides = () => {
			slides.forEach((slide, index) => {
				const image = slideImages?.[index];
				if (!image?.naturalWidth || !image.naturalHeight) return;

				const imageRatio = image.naturalWidth / image.naturalHeight;
				const availableWidth = gallery.clientWidth * .88;
				slide.style.width = `${Math.min(slide.clientHeight * imageRatio, availableWidth)}px`;
			});
		};

		const setProgress = (value: number) => {
			const safeProgress = clamp(value);
			const maxOffset = Math.max(track.scrollWidth - gallery.clientWidth, 0);
			track.style.transform = `translate3d(${-safeProgress * maxOffset}px, 0, 0)`;
			if (progress) progress.style.transform = `scaleX(${safeProgress})`;
			currentSlide = Math.round(safeProgress * (slides.length - 1));
		};

		const updateGallery = () => {
			frame = 0;
			const bounds = gallery.getBoundingClientRect();
			const range = Math.max(gallery.offsetHeight - window.innerHeight, 1);
			targetProgress = clamp(-bounds.top / range);
			if (reduceMotion) {
				renderedProgress = targetProgress;
				setProgress(renderedProgress);
				return;
			}

			const animate = () => {
				renderedProgress += (targetProgress - renderedProgress) * .14;
				setProgress(renderedProgress);
				if (Math.abs(targetProgress - renderedProgress) > .001) {
					smoothingFrame = window.requestAnimationFrame(animate);
				} else {
					smoothingFrame = 0;
				}
			};
			if (!smoothingFrame) smoothingFrame = window.requestAnimationFrame(animate);
		};

		const requestUpdate = () => {
			if (!frame) frame = window.requestAnimationFrame(updateGallery);
		};

		const moveToSlide = (slideIndex: number) => {
			const target = Math.max(0, Math.min(slides.length - 1, slideIndex));
			const range = Math.max(gallery.offsetHeight - window.innerHeight, 1);
			window.scrollTo({
				top: gallery.offsetTop + (range * target) / (slides.length - 1),
				behavior: reduceMotion ? 'auto' : 'smooth',
			});
		};

		previousButton?.addEventListener('click', () => moveToSlide(currentSlide - 1));
		nextButton?.addEventListener('click', () => moveToSlide(currentSlide + 1));
		window.addEventListener('scroll', requestUpdate, { passive: true });
		slideImages?.forEach((image) => image.addEventListener('load', resizeSlides, { once: true }));
		window.addEventListener('resize', () => {
			resizeSlides();
			requestUpdate();
		});
		resizeSlides();
		updateGallery();
	}
</script>

<style>
	.scroll-gallery {
		position: relative;
		height: 300svh;
		background: #5ae8e1;
		color: #123047;
	}

	.scroll-gallery-stage {
		position: sticky;
		top: 0;
		display: flex;
		box-sizing: border-box;
		height: 100svh;
		height: 100dvh;
		min-height: 36rem;
		align-items: center;
		justify-content: center;
		padding: 5rem clamp(1rem, 6vw, 6rem) 4rem;
		overflow: hidden;
		background:
			linear-gradient(135deg, rgba(255, 255, 255, .42), transparent 48%),
			hsl(208, 48%, 89%);
	}

	.scroll-gallery-stage::before {
		position: absolute;
		inset: 0;
		z-index: -1;
		background-image: linear-gradient(rgba(18, 48, 71, .045) 1px, transparent 1px), linear-gradient(90deg, rgba(18, 48, 71, .045) 1px, transparent 1px);
		background-size: 3rem 3rem;
		content: '';
		mask-image: linear-gradient(90deg, transparent, #000 18%, #000 82%, transparent);
	}

	.gallery-heading {
		position: absolute;
		top: clamp(1.5rem, 5vw, 3rem);
		left: clamp(1rem, 6vw, 6rem);
		max-width: calc(100% - 2rem);
		z-index: 3;
	}

	.gallery-heading p {
		margin: 0 0 .25rem;
		color: #002a46;
		font-size: .7rem;
		letter-spacing: .18em;
		text-transform: uppercase;
	}

	.gallery-heading h2 {
		margin: 0;
		color: #123047;
		font-family: var(--font-titulos);
		font-size: clamp(2rem, 5vw, 4rem);
		font-weight: var(--grosor-titulos);
		line-height: 1;
	}

	.gallery-track {
		display: flex;
		width: 100%;
		max-width: 100%;
		gap: clamp(1.25rem, 4vw, 3.5rem);
		transform: translate3d(0, 0, 0);
		will-change: transform;
	}

	.gallery-slide {
		position: relative;
		flex: 0 0 auto;
		width: min(76vw, 58rem);
		height: min(64svh, 40rem);
		max-width: 100%;
		margin: 0;
		overflow: hidden;
		border: 1px solid rgba(69, 107, 164, 0.45);
		border-radius: .9rem;
		background: #123047;
		box-shadow: 0 1.5rem 3rem rgba(18, 48, 71, .16), 0 .35rem 0 rgba(48, 68, 168, 0.6) inset;
	}

	.gallery-slide::after {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(18, 48, 71, .02) 42%, rgba(18, 48, 71, .55) 100%);
		content: '';
		pointer-events: none;
	}

	.gallery-slide img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		object-position: center center;
		filter: saturate(1.08) contrast(1.04) brightness(1.08);
		transition: transform .8s cubic-bezier(.2, .7, .2, 1);
	}

	.gallery-slide:hover img {
		transform: scale(1.04);
	}

	.gallery-slide figcaption {
		position: absolute;
		right: 1.25rem;
		bottom: 1rem;
		z-index: 1;
		margin: 0;
		color: #fff;
		font-size: .72rem;
		letter-spacing: .18em;
		text-shadow: 0 1px 1px rgba(18, 48, 71, .35);
	}

	.gallery-slide figcaption span {
		font-size: 1.15rem;
	}

	.gallery-controls {
		position: absolute;
		right: clamp(1rem, 6vw, 6rem);
		bottom: clamp(1.5rem, 5vw, 3rem);
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: .45rem .65rem;
		border: 1px solid rgba(69, 69, 164, 0.38);
		border-radius: 999px;
		background: rgba(255, 252, 246, .78);
		backdrop-filter: blur(10px);
	}

	.gallery-arrow {
		display: grid;
		width: 2.7rem;
		height: 2.7rem;
		place-items: center;
		border: 1px solid #123047;
		border-radius: 50%;
		background: transparent;
		color: #123047;
		font-size: 1.2rem;
		cursor: pointer;
		transition: background-color .25s ease, color .25s ease;
	}

	.gallery-arrow:hover,
	.gallery-arrow:focus-visible {
		background: #123047;
		color: #fff;
	}

	.gallery-progress {
		width: clamp(5rem, 14vw, 10rem);
		height: 2px;
		background: rgba(18, 48, 71, .2);
	}

	.gallery-progress span {
		display: block;
		width: 100%;
		height: 100%;
		background: #003288;
		transform: scaleX(0);
		transform-origin: left center;
	}

	.gallery-hint {
		position: absolute;
		bottom: clamp(1.7rem, 5vw, 3.3rem);
		left: clamp(1rem, 6vw, 6rem);
		margin: 0;
		color: #173476;
		font-size: .68rem;
		letter-spacing: .15em;
		text-transform: uppercase;
	}

	@media (max-width: 600px) {
		.scroll-gallery {
			height: 270svh;
		}

		.scroll-gallery-stage {
			min-height: 30rem;
			padding: 5.5rem .75rem 5rem;
		}

		.gallery-heading {
			top: 1.25rem;
			left: 1rem;
		}

		.gallery-heading p {
			font-size: .62rem;
			letter-spacing: .14em;
		}

		.gallery-slide {
			width: min(88vw, 31rem);
			height: min(58svh, 32rem);
			border-radius: .65rem;
		}

		.gallery-controls {
			right: 50%;
			bottom: 1.15rem;
			transform: translateX(50%);
			gap: .65rem;
			padding: .35rem .5rem;
		}

		.gallery-arrow {
			width: 2.35rem;
			height: 2.35rem;
			font-size: 1rem;
		}

		.gallery-progress {
			width: clamp(4rem, 24vw, 7rem);
		}

		.gallery-hint {
			display: none;
		}
	}

	@media (max-width: 380px) {
		.scroll-gallery-stage {
			min-height: 28rem;
			padding-top: 5rem;
		}

		.gallery-slide {
			height: min(54svh, 27rem);
		}

		.gallery-controls {
			bottom: .8rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.gallery-track,
		.gallery-slide img,
		.gallery-arrow {
			transition: none;
		}
	}
</style>
