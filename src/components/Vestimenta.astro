---
// Vestimenta.astro
// Tarjeta "Dresscode" coherente con el hero: papel azul grisáceo con textura,
// tipografía del hero, ilustración lineal en azul marino y swatches de colores.
---

<section class="dresscode" aria-labelledby="dresscode-title">
  <div class="dresscode-card">
    <img
      class="dresscode-texture"
      src="/portada.webp"
      alt=""
      aria-hidden="true"
      loading="lazy"
      decoding="async"
    />

    <h2 id="dresscode-title" class="dresscode-script">Código de vestimenta</h2>
    <div class="dresscode-rule" aria-hidden="true"></div>

    <div class="dresscode-figure">
      <svg
        viewBox="0 0 360 400"
        role="img"
        aria-label="Ilustración: vestido de gala en maniquí junto a un caballero en esmoquin"
      >
        <!-- Vestido en maniquí -->
        <g
          fill="none"
          stroke="#1c3a56"
          stroke-width="2.4"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <!-- gancho de exhibición -->
          <path d="M124,29 a5.5,5.5 0 1,1 0.01,0" stroke-width="1.8" />
          <path d="M124,35 L124,44" stroke-width="1.8" />
          <!-- silueta del maniquí (torso sin cabeza ni brazos) -->
          <path d="M104,66 C104,50 118,44 124,44 C136,42 144,50 144,66" />
          <!-- línea del pecho dentro del escote en V -->
          <path d="M112,80 C118,88 128,88 134,80" opacity="0.7" />
          <!-- vestido de gala sirena con escote en V profundo -->
          <path
            d="M104,66 C98,84 92,104 90,124 C88,150 90,176 100,200 C108,222 110,246 108,268 C96,288 80,318 60,348 L188,348 C168,318 152,288 140,268 C138,246 140,222 148,200 C158,176 160,150 158,124 C156,104 150,84 144,66 C138,72 130,90 122,104 C112,86 108,72 104,66 Z"
          />
        </g>

        <!-- Caballero en esmoquin -->
        <g
          transform="matrix(0.9 0 0 0.9 24.6 35)"
          fill="none"
          stroke="#1c3a56"
          stroke-width="2.4"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <!-- rostro -->
          <path
            d="M231,40 C232,30 238,22 246,22 C258,22 264,32 264,44 C264,56 257,66 246,66 C236,66 230,56 231,40 Z"
          />
          <!-- cabello -->
          <path d="M236,25 C246,21 256,23 261,28" stroke-width="1.8" />
          <path d="M236,32 C246,28 258,30 262,35" stroke-width="1.8" />
          <path d="M263,40 C265,48 264,55 261,61" stroke-width="1.8" />
          <!-- cuello -->
          <path d="M241,64 L241,72" stroke-width="1.8" />
          <path d="M251,64 L251,72" stroke-width="1.8" />
          <!-- cuello de la camisa -->
          <path d="M244,71 C245,78 252,78 253,71" />
          <!-- torso / chaqueta -->
          <path
            d="M246,74 C220,70 206,78 202,92 C198,104 190,116 186,128 C198,140 210,146 216,160 C218,180 218,198 218,210 L214,212 C234,218 266,218 286,212 L282,210 C282,198 282,180 284,160 C290,146 302,140 314,128 C310,116 302,104 298,92 C294,78 280,70 246,74 Z"
          />
          <!-- solapas y escote de la camisa -->
          <path d="M241,77 C238,88 234,100 232,110" />
          <path d="M251,77 C254,88 258,100 260,110" />
          <path d="M246,88 L237,114 M246,88 L255,114" />
          <!-- pajarita -->
          <path
            d="M248,75 L230,81 L230,87 L248,80 Z M248,75 L266,81 L266,87 L248,80 Z"
            stroke-width="1.8"
          />
          <rect
            x="244.5"
            y="75"
            width="7"
            height="9"
            rx="2"
            stroke-width="1.8"
          />
          <!-- manos en los bolsillos -->
          <circle cx="214" cy="163" r="5" stroke-width="1.8" />
          <circle cx="284" cy="163" r="5" stroke-width="1.8" />
          <!-- pantalón -->
          <path
            d="M214,210 C214,250 216,294 216,316 C216,332 217,342 219,350 L241,350 C241,344 242,334 242,316 C242,294 241,250 241,210 Z"
          />
          <path
            d="M259,210 C259,250 258,294 258,316 C258,332 259,342 261,350 L283,350 C285,342 285,332 285,316 C285,294 283,250 283,210 Z"
          />
          <!-- zapatos -->
          <path
            d="M204,348 L248,348 C252,348 252,359 248,359 L204,359 C200,359 200,348 204,348 Z"
            stroke-width="1.8"
          />
          <path
            d="M251,348 L293,348 C297,348 297,359 293,359 L251,359 C247,359 247,348 251,348 Z"
            stroke-width="1.8"
          />
        </g>
      </svg>
    </div>

    <p class="dresscode-text">
      El novio vestirá de <em>Azul noche</em> y la novia de <em>Perla</em>.
    </p>

    <div class="dresscode-swatches">
      <div class="dresscode-swatch">
        <span class="dresscode-swatch__dot dresscode-swatch__dot--navy"></span>
        <span class="dresscode-swatch__label">Azul noche</span>
      </div>
      <div class="dresscode-swatch">
        <span class="dresscode-swatch__dot dresscode-swatch__dot--perla"></span>
        <span class="dresscode-swatch__label">Perla</span>
      </div>
    </div>

    <p class="dresscode-note">
      Estos colores están reservados para los novios. Pedimos a nuestros
      invitados evitarlos en su vestimenta. ¡Gracias por acompañarnos!
    </p>

    <!-- Motivo floral discreto, línea fina -->
    <svg
      class="dresscode-floral"
      viewBox="0 0 160 56"
      fill="none"
      stroke="#3d6c8f"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M18,50 C46,48 70,38 84,18" />
      <path d="M142,50 C114,48 90,38 76,18" />
      <path d="M40,44 C34,40 31,34 33,30 C39,34 42,40 40,44 Z" />
      <path d="M58,36 C52,32 49,26 51,22 C57,26 60,32 58,36 Z" />
      <path d="M70,27 C65,24 62,19 63,15 C68,18 71,23 70,27 Z" />
      <path d="M120,44 C126,40 129,34 127,30 C121,34 118,40 120,44 Z" />
      <path d="M102,36 C108,32 111,26 109,22 C103,26 100,32 102,36 Z" />
      <path d="M90,27 C95,24 98,19 97,15 C92,18 89,23 90,27 Z" />
      <circle cx="74" cy="9" r="4.5" />
      <circle cx="86" cy="9" r="4.5" />
      <circle cx="71" cy="16" r="4.5" />
      <circle cx="89" cy="16" r="4.5" />
      <circle cx="74" cy="23" r="4.5" />
      <circle cx="86" cy="23" r="4.5" />
      <circle cx="80" cy="16" r="2.4" fill="#3d6c8f" stroke="none" />
    </svg>
  </div>
</section>

<style>
  .dresscode {
    display: flex;
    justify-content: center;
    background: #dcebf4;
    padding: clamp(2rem, 6vh, 3.5rem) 1rem;
  }

  .dresscode-card {
    position: relative;
    overflow: hidden;
    width: min(100%, 27rem);
    background: linear-gradient(180deg, #dce6ef 0%, #cdd9e6 100%);
    box-shadow: 0 0 2rem rgba(4, 41, 74, 0.32);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: clamp(3rem, 7vh, 4.5rem) clamp(1.5rem, 6vw, 3rem)
      clamp(2.25rem, 6vh, 3.25rem);
  }

  .dresscode-texture {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.4;
    pointer-events: none;
  }

  .dresscode-script,
  .dresscode-rule,
  .dresscode-figure,
  .dresscode-text,
  .dresscode-swatches,
  .dresscode-note,
  .dresscode-floral {
    position: relative;
  }

  .dresscode-script {
    margin: 0;
    color: #1c3a56;
    font-family: var(--font-nombres-portada);
    font-size: clamp(2.6rem, 9vw, 4rem);
    font-weight: var(--grosor-nombres-portada);
    line-height: 0.95;
    letter-spacing: -0.02em;
  }

  .dresscode-rule {
    width: min(100%, 15rem);
    height: 1px;
    margin: 1.2rem 0 0;
    background: #3d6c8f;
    opacity: 0.5;
  }

  .dresscode-figure {
    width: clamp(210px, 62vw, 272px);
    margin: clamp(2rem, 6vh, 3.25rem) 0 clamp(1.75rem, 5vh, 2.75rem);
  }

  .dresscode-text {
    margin: 0;
    max-width: 24rem;
    color: #2e4a63;
    font-family: var(--font-frase-portada);
    font-size: clamp(1rem, 3.2vw, 1.1rem);
    font-weight: var(--grosor-frase-portada);
    line-height: 1.65;
  }

  .dresscode-swatches {
    display: flex;
    justify-content: center;
    gap: 2.6rem;
    margin: 1.5rem 0 0;
  }

  .dresscode-swatch {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
  }

  .dresscode-swatch__dot {
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    display: block;
    box-shadow: 0 0.15rem 0.5rem rgba(4, 41, 74, 0.18);
  }

  .dresscode-swatch__dot--navy {
    background: #1b2a4a;
  }

  .dresscode-swatch__dot--perla {
    background: #e9e4d8;
    border: 1px solid #c9c2b0;
  }

  .dresscode-swatch__label {
    color: #2e4a63;
    font-family: var(--font-subtitulos);
    font-size: 0.72rem;
    font-weight: var(--grosor-fuente-semi-bold);
    letter-spacing: 0.08em;
  }

  .dresscode-note {
    margin: 1.7rem 0 0;
    max-width: 24rem;
    color: #5a7089;
    font-family: var(--font-frase-portada);
    font-size: 0.8rem;
    font-weight: var(--grosor-frase-portada);
    line-height: 1.7;
  }

  .dresscode-floral {
    width: 9rem;
    margin-top: 1.9rem;
    opacity: 0.55;
  }

  @media (max-width: 420px) {
    .dresscode {
      padding: 1.5rem 0.5rem;
    }

    .dresscode-card {
      padding-left: 1.25rem;
      padding-right: 1.25rem;
    }
  }
</style>