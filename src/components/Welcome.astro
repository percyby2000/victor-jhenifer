<main class="invitation-cover">
	<div class="cover-content">
		<span class="monogram" aria-hidden="true">
			<span class="monogram-a">V</span>
			<span class="monogram-l">J</span>
		</span>

		<button class="open-invitation" type="button" aria-label="Abrir invitación de Victor y Jhenifer">
			<span class="open-label">Presiona para<br />abrir</span>

			<span class="ribbon-row">
				<span class="bow-frame">
					<img class="bow" src="/mon.webp" alt="Mo&ntilde;o blanco de la invitaci&oacute;n" width="560" height="560" />
				</span>
			</span>
		</button>

		<p class="hint">Nuestra boda</p>
		<p class="names">Victor <span>&amp;</span> Jhenifer</p>
	</div>
</main>
<script>
	const openButton = document.querySelector<HTMLButtonElement>('.open-invitation');
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	openButton?.addEventListener('click', () => {
		if (openButton.disabled) return;
		openButton.disabled = true;
		if (!prefersReducedMotion) {
			const AudioContextClass = window.AudioContext || (window as typeof window & {
				webkitAudioContext?: typeof AudioContext;
			}).webkitAudioContext;
			if (AudioContextClass) {
				const audioContext = new AudioContextClass();
				const oscillator = audioContext.createOscillator();
				const gain = audioContext.createGain();
				oscillator.type = 'sine';
				oscillator.frequency.setValueAtTime(660, audioContext.currentTime);
				oscillator.frequency.exponentialRampToValueAtTime(990, audioContext.currentTime + 0.16);
				gain.gain.setValueAtTime(0.0001, audioContext.currentTime);
				gain.gain.exponentialRampToValueAtTime(0.12, audioContext.currentTime + 0.02);
				gain.gain.exponentialRampToValueAtTime(0.0001, audioContext.currentTime + 0.34);
				oscillator.connect(gain).connect(audioContext.destination);
				oscillator.start();
				oscillator.stop(audioContext.currentTime + 0.34);
			}
		}

		document.querySelector('.invitation-cover')?.classList.add('is-opening');
		window.setTimeout(() => {
			window.location.href = '/victor&jhenifer';
		}, prefersReducedMotion ? 0 : 2400);
	});
</script>

