	}

	:global(.scroll-reveal) {
		opacity: 0;
		transform: translateY(1rem);
		transition: opacity .8s ease var(--reveal-delay, 0ms), transform .8s cubic-bezier(.2, .75, .25, 1) var(--reveal-delay, 0ms);
	}

	:global(.scroll-reveal.is-revealed) {
		opacity: 1;
